{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asset-agent-asa.local/contracts/compatible_version_set_release_manifest_v1.schema.json",
  "title": "AAA Balanced v1 Compatible Version Set / Release Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["release_set_id", "component_refs", "component_set_sha256", "compatibility_declaration_ref", "exact_decision_receipt_ref"],
  "properties": {
    "release_set_id": {"type": "string", "minLength": 1, "not": {"enum": ["latest", "HEAD", "current"]}},
    "component_refs": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["component_kind", "immutable_identity", "version", "content_hash_or_git_identity", "verified"],
        "properties": {
          "component_kind": {"enum": ["SCHEMA", "MODEL", "FEATURE_SPEC", "MODEL_INPUT_CONTRACT", "SCORER_IO", "EXECUTION_PROFILE", "RUNTIME_SOURCE", "CONFIGURATION", "DATASET", "SNAPSHOT", "PIT_CONTRACT", "VALIDATION_DATASET", "CALENDAR_WINDOW_MAPPING", "SHARED_CONTRACT", "MODEL_ARTIFACT_RELEASE_MANIFEST"]},
          "immutable_identity": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1, "not": {"enum": ["latest", "HEAD", "current"]}},
          "content_hash_or_git_identity": {"type": "string", "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"},
          "byte_size": {"type": "integer", "minimum": 0},
          "persistent_locator": {"type": "string", "minLength": 1},
          "verified": {"type": "boolean"}
        }
      }
    },
    "component_set_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "compatibility_declaration_ref": {"type": "string", "minLength": 1},
    "exact_decision_receipt_ref": {"type": "string", "minLength": 1}
  },
  "x-aaa-invariants": [
    "floating latest is prohibited as authoritative release identity",
    "all component identities are immutable exact identities",
    "individually valid components are not automatically a compatible set",
    "material component change creates a different component_set_sha256",
    "existing MIS/VDI/SIO/MARM/PIT/WM semantics are referenced, not rewritten"
  ]
}
