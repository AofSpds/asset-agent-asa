{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asset-agent-asa.local/contracts/provider.schema.json",
  "title": "AAA Provider Capability Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["provider_id", "capabilities", "health"],
  "properties": {
    "provider_id": {"type": "string", "minLength": 1},
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["invoke", "stream", "structured_output", "tool_calling"],
      "properties": {
        "invoke": {"type": "boolean"},
        "stream": {"type": "boolean"},
        "structured_output": {"type": "boolean"},
        "tool_calling": {"type": "boolean"}
      }
    },
    "health": {"enum": ["HEALTHY", "DEGRADED", "OFFLINE", "UNKNOWN"]},
    "cost_metadata": {"type": ["object", "null"]}
  }
}
