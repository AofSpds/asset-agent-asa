{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "m3top3-outcome-blind-access-sidecar-schema-v0.1",
  "title": "M3Top3 Outcome-Blind Access Sidecar v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sidecar_id",
    "bundle_id",
    "created_at",
    "events",
    "role_separation",
    "outcome_exposure_state",
    "admission"
  ],
  "properties": {
    "sidecar_id": {"type": "string", "minLength": 1},
    "bundle_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["event_id", "actor_id", "role", "accessed_at", "action", "artifact_sha256"],
        "properties": {
          "event_id": {"type": "string"},
          "actor_id": {"type": "string"},
          "role": {"type": "string", "enum": ["RETRIEVER", "ANNOTATOR_A", "ANNOTATOR_B", "ADJUDICATOR", "CUSTODIAN"]},
          "accessed_at": {"type": "string", "format": "date-time"},
          "action": {"type": "string", "enum": ["RETRIEVE", "READ", "ANNOTATE", "ADJUDICATE", "SEAL"]},
          "artifact_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "outcome_surface_accessed": {"const": false}
        }
      }
    },
    "role_separation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["retrieval_and_outcome_roles_separate", "independent_annotators_distinct", "iva_used_as_executor"],
      "properties": {
        "retrieval_and_outcome_roles_separate": {"const": true},
        "independent_annotators_distinct": {"type": "boolean"},
        "iva_used_as_executor": {"const": false}
      }
    },
    "outcome_exposure_state": {"type": "string", "enum": ["CONCEALED_PROVEN", "UNPROVEN", "BREACH"]},
    "breach_ref": {"type": ["string", "null"]},
    "admission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed", "reason"],
      "properties": {
        "allowed": {"type": "boolean"},
        "reason": {"type": "string"}
      }
    }
  }
}
