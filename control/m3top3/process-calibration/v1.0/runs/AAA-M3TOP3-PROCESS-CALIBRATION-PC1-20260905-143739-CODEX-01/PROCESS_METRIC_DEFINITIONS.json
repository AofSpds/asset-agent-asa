  "metric_definitions": {
    "RETRIEVAL_HIT_RATE": "useful_source_hits / retrieval_attempts",
    "PIT_ADMISSION_YIELD": "pit_admitted_values / pit_candidate_values",
    "TRANSFORM_SUCCESS_RATE": "transformed_usable_values / admitted_source_values",
    "SCOREABILITY_GAIN": "terminal_scoreable_rows - baseline_scoreable_rows",
    "SCOREABLE_ROWS_PER_WALL_HOUR": "new_scoreable_rows / elapsed_wall_hours",
    "SCOREABLE_ROWS_PER_ACTIVE_HOUR": "new_scoreable_rows / measured_active_hours; otherwise NOT_INSTRUMENTED",
    "COVERAGE_GAIN_PER_WALL_HOUR": "(terminal_scoreable_rows / 57 - baseline_scoreable_rows / 57) / elapsed_wall_hours",
    "RETRY_RATE": "retry_attempts / retrieval_attempts",
    "CACHE_HIT_RATE": "cache_hits / cache_lookups where caching exists",
    "DUPLICATE_FETCH_RATE": "duplicate_fetches / retrieval_attempts",
    "VALIDATION_REWORK_RATIO": "measured_rework_or_recheck_active_ms / measured_validation_active_ms; otherwise NOT_INSTRUMENTED",
    "NO_EVIDENCE_REPEAT_COUNT": "count of repeated same-route same-failure attempts with no new evidence",
    "ROUTE_SWITCH_COUNT": "count of explicit route changes after a terminal, duplicate, or repeated-no-evidence result",
    "TOKEN_OR_CRU_PER_SCOREABLE_ROW": "platform token or CRU numerator / new_scoreable_rows; otherwise NOT_INSTRUMENTED"
  },
  "outcome_taxonomy": [
